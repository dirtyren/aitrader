.worktrees/
.env
logs/
mysql/
runtime/*
!runtime/.gitkeep
!runtime/bars_cache/
runtime/bars_cache/*
!runtime/bars_cache/.gitkeep
__pycache__/
*.pyc
nginx/certs/

# Emergency halt lock file (risk/circuit_breakers.py writes LOCK_FILE_PATH,
# default ./lock.file). It must NEVER be committed: SystemHaltedFilter
# rejects every entry while it exists, so a stray `git add -A` would halt a
# live strategy on the next deploy.
lock.file
lock.file.tmp

# Local virtualenvs
.venv/
.venv-mac/

# Agent scratch: SDD ledgers, task briefs, review packages, reports.
# Never committed — the git history is the record.
.superpowers/
